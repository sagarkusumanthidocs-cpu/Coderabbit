generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  STORE_OWNER
  ADMIN
}

enum ModerationStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum OrderStatus {
  ORDER_PLACED
  STORE_ACCEPTED
  PREPARING_GIFT
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
}

enum DeliveryOption {
  STANDARD
  EXPRESS
  SCHEDULED
}

enum DeliverySlot {
  MORNING
  AFTERNOON
  EVENING
}

enum PaymentMethod {
  COD
  UPI_MOCK
  CARD_MOCK
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  stores         Store[]
  orders         Order[]
  statusChanges  OrderStatusHistory[]
  reminders      Reminder[]
  groupGifts     GroupGift[]
  cartItems      CartItem[]

  @@index([role])
}

model City {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  stores     Store[]
  orders     Order[]
  groupGifts GroupGift[]
}

model Category {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  icon      String  @default("Gift")
  sortOrder Int     @default(0)

  stores   Store[]
  products Product[]
}

model Store {
  id               String           @id @default(cuid())
  ownerUserId      String
  owner            User             @relation(fields: [ownerUserId], references: [id])
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  cityId           String
  city             City             @relation(fields: [cityId], references: [id])
  name             String
  description      String
  address          String
  coverImage       String
  isOpen           Boolean          @default(true)
  openTime         String           @default("09:00")
  closeTime        String           @default("21:00")
  moderationStatus ModerationStatus @default(APPROVED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  products Product[]
  orders   Order[]

  @@index([cityId])
  @@index([ownerUserId])
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems     OrderItem[]
  groupGiftItems GroupGiftItem[]
  cartItems      CartItem[]

  @@index([storeId])
  @@index([categoryId])
}

model CartItem {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model Order {
  id              String         @id @default(cuid())
  orderCode       String         @unique
  customerId      String
  customer        User           @relation(fields: [customerId], references: [id])
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id])
  cityId          String
  city            City           @relation(fields: [cityId], references: [id])
  status          OrderStatus    @default(ORDER_PLACED)

  recipientName    String
  recipientPhone   String
  deliveryAddress  String
  landmark         String?
  pincode          String?

  senderName   String
  occasion     String
  giftMessage  String?

  deliveryOption DeliveryOption
  deliveryDate   DateTime?
  deliverySlot   DeliverySlot?

  paymentMethod PaymentMethod

  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  rejectionReason             String?
  proofImage                  String?
  deliveryConfirmedByCustomer Boolean @default(false)

  idempotencyKey String  @unique
  version        Int     @default(1)

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([customerId])
  @@index([storeId])
  @@index([status])
  @@index([cityId])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id])
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  productName   String
  unitPrice     Decimal @db.Decimal(10, 2)
  quantity      Int
  lineTotal     Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

enum OccasionType {
  BIRTHDAY
  ANNIVERSARY
  WEDDING
  FESTIVAL
  OTHER
}

enum SplitType {
  EQUAL
  CUSTOM
}

model Reminder {
  id            String       @id @default(cuid())
  customerId    String
  customer      User         @relation(fields: [customerId], references: [id])
  occasionName  String
  recipientName String
  occasionType  OccasionType
  date          DateTime
  repeatYearly  Boolean      @default(false)
  remindMe      String
  giftCategory  String?
  note          String?
  giftPlanned   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([customerId])
}

model GroupGift {
  id            String       @id @default(cuid())
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  title         String
  occasionType  OccasionType
  recipientName String
  cityId        String
  city          City         @relation(fields: [cityId], references: [id])
  deliveryDate  DateTime
  goalAmount    Decimal      @db.Decimal(10, 2)
  splitType     SplitType    @default(EQUAL)
  message       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items         GroupGiftItem[]
  contributors  GroupGiftContributor[]

  @@index([createdById])
}

model GroupGiftItem {
  id          String    @id @default(cuid())
  groupGiftId String
  groupGift   GroupGift @relation(fields: [groupGiftId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  @@index([groupGiftId])
}

model GroupGiftContributor {
  id          String    @id @default(cuid())
  groupGiftId String
  groupGift   GroupGift @relation(fields: [groupGiftId], references: [id])
  name        String
  amount      Decimal   @db.Decimal(10, 2)
  paid        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([groupGiftId])
}

model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id])
  previousStatus  OrderStatus?
  status          OrderStatus
  changedById     String?
  changedBy       User?       @relation(fields: [changedById], references: [id])
  changedByRole   Role
  note            String?
  isAdminOverride Boolean     @default(false)
  isSkipped       Boolean     @default(false)
  changedAt       DateTime    @default(now())

  @@index([orderId])
}
